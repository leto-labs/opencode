<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Foreground service permissions for background voice session -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Wake lock to prevent CPU sleep during voice session -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Notification permission for foreground service (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="app.tauri.foregroundservice.ForegroundService"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:exported="false" />
    </application>
</manifest>
